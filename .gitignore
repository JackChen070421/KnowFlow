# ============================================================
# KnowFlow .gitignore
# 原则：真实数据、密钥、模型权重、运行产物一律不入库。
# 唯一例外：examples/ 下的合成样例。
# ============================================================

# --- secrets ---
.env
.env.*
!.env.example
*.key
*.pem
credentials*
secrets*

# --- competition data: never commit ---
# 官方资料包已落地为 data/raw/official-v1/（21 文件 / 73 MB，原样保留目录与文件名）。
# 前两行是对 data/raw/** 的显式复述：写清楚“这里确实有数据，且它必须被忽略”，
# 避免以后有人为了让检查通过而删数据。
data/raw/official-v1/**
data/raw/*/manifest.json
data/raw/**
data/interim/**
data/external/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/external/.gitkeep

# Defense in depth: any CSV/XLSX/Parquet outside examples is assumed restricted.
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.jsonl
!examples/**/*.csv
!examples/**/*.tsv
!examples/**/*.jsonl

# Data-like JSON under data/ (schemas live under schemas/)
data/**/*.json
# 例外：纯指纹清单（路径 + sha256 + 字节数 + 行数，无任何数据内容）允许入库。
# 它是组员核对“我这份和别人那份是否字节一致”的唯一依据；data/raw 仍然是封闭的。
!data/manifests/*.structure.json

# --- model weights / large binaries ---
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.gguf
*.h5
*.pkl
*.joblib

# --- runtime artifacts ---
artifacts/
*.log
*.tmp
*.bak

# --- deliverable artifacts: keep out of the repo ---
*.pdf
*.mp4
*.mov
*.pptx
*.docx
*.zip

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- notebooks ---
.ipynb_checkpoints/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- keep directory markers ---
!**/.gitkeep
