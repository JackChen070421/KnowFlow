{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflow.local/schemas/output/student_profile.schema.json",
  "title": "student_profile.json",
  "description": "任务2个人画像 v0.3；新增字段为兼容旧样例的可选字段，新生产方始终输出。mastery 为满分成功率的 Beta 后验均值；部分得分另见 performance。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "student_id",
    "group_id",
    "generated_at",
    "source_dataset",
    "coverage",
    "knowledge_states",
    "objective_states",
    "issues",
    "lists"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "student_id": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "group_id": {
      "type": "string",
      "pattern": "^G[0-9]{1,2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_dataset": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_items",
        "applicable_items",
        "ratio",
        "observed_knowledge",
        "total_knowledge"
      ],
      "properties": {
        "observed_items": {
          "type": "integer",
          "minimum": 0
        },
        "applicable_items": {
          "type": "integer",
          "minimum": 0
        },
        "ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "observed_knowledge": {
          "type": "integer",
          "minimum": 0
        },
        "total_knowledge": {
          "type": "integer",
          "minimum": 0
        },
        "scope_known": {
          "type": "boolean"
        }
      }
    },
    "knowledge_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "objective_id",
          "mastery",
          "confidence",
          "evidence_count",
          "status",
          "state_counts",
          "evidence"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string",
            "pattern": "^K-[0-9]{2,3}$"
          },
          "objective_id": {
            "type": "string",
            "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$"
          },
          "mastery": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "后验均值；无观测时为 null，不是 0"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed_weak",
              "likely_weak",
              "insufficient_evidence",
              "likely_mastered",
              "confirmed_mastered",
              "mixed_performance",
              "not_applicable"
            ]
          },
          "state_counts": {
            "type": "object",
            "additionalProperties": false,
            "description": "五项之和 = 该知识点可测材料数；evidence_count = observed_correct + observed_wrong。",
            "required": [
              "observed_correct",
              "observed_wrong",
              "assigned_not_attempted",
              "pending",
              "unobserved"
            ],
            "properties": {
              "observed_correct": {
                "type": "integer",
                "minimum": 0
              },
              "observed_wrong": {
                "type": "integer",
                "minimum": 0
              },
              "assigned_not_attempted": {
                "type": "integer",
                "minimum": 0
              },
              "pending": {
                "type": "integer",
                "minimum": 0,
                "description": "已作答但未评分的材料项数；不计入 evidence_count，也不判为错误"
              },
              "unobserved": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R-[0-9]{4}$"
            },
            "uniqueItems": true
          },
          "credible_interval": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "weak_probability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "mastered_probability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "applicable_items": {
            "type": "integer",
            "minimum": 0
          },
          "status_reason": {
            "type": "string",
            "minLength": 1
          },
          "performance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "full_credit",
              "partial_credit",
              "zero_credit",
              "mean_score_ratio"
            ],
            "properties": {
              "full_credit": {
                "type": "integer",
                "minimum": 0
              },
              "partial_credit": {
                "type": "integer",
                "minimum": 0
              },
              "zero_credit": {
                "type": "integer",
                "minimum": 0
              },
              "mean_score_ratio": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "objective_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id",
          "mastery",
          "confidence",
          "evidence_count",
          "status",
          "derived_from",
          "unobserved_knowledge_ids"
        ],
        "properties": {
          "objective_id": {
            "type": "string",
            "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$"
          },
          "mastery": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed_weak",
              "likely_weak",
              "insufficient_evidence",
              "likely_mastered",
              "confirmed_mastered",
              "mixed_performance",
              "not_applicable"
            ]
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^K-[0-9]{2,3}$"
            },
            "uniqueItems": true
          },
          "unobserved_knowledge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^K-[0-9]{2,3}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "type",
          "knowledge_id",
          "objective_id",
          "statement",
          "evidence",
          "severity"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^IS-[0-9]{3}-[0-9]{2,3}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "concept_confusion",
              "procedure_gap",
              "reading_error",
              "prerequisite_gap",
              "transfer_gap",
              "insufficient_evidence",
              "performance_gap",
              "score_point_gap"
            ]
          },
          "knowledge_id": {
            "type": "string",
            "pattern": "^K-[0-9]{2,3}$"
          },
          "objective_id": {
            "type": "string",
            "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "records",
              "material_ids",
              "stat"
            ],
            "properties": {
              "records": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^R-[0-9]{4}$"
                },
                "uniqueItems": true
              },
              "material_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^M-[0-9]{3}$"
                },
                "uniqueItems": true
              },
              "stat": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "rubric_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "record_id",
                "material_id",
                "point_id",
                "criterion",
                "score",
                "max_score"
              ],
              "properties": {
                "record_id": {
                  "type": "string",
                  "pattern": "^R-[0-9]{4}$"
                },
                "material_id": {
                  "type": "string",
                  "pattern": "^M-[0-9]{3}$"
                },
                "point_id": {
                  "type": "string",
                  "minLength": 1
                },
                "criterion": {
                  "type": "string",
                  "minLength": 1
                },
                "score": {
                  "type": "number",
                  "minimum": 0
                },
                "max_score": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strengths",
        "needs_consolidation",
        "needs_observation"
      ],
      "properties": {
        "strengths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/list_item"
          }
        },
        "needs_consolidation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/list_item"
          }
        },
        "needs_observation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/list_item"
          }
        }
      }
    },
    "node_id": {
      "type": "string",
      "pattern": "^N[0-9]{2,3}$"
    }
  },
  "$defs": {
    "list_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_id",
        "reason"
      ],
      "properties": {
        "knowledge_id": {
          "type": "string",
          "pattern": "^K-[0-9]{2,3}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.3.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "node_id"
        ],
        "properties": {
          "coverage": {
            "required": [
              "scope_known"
            ]
          },
          "knowledge_states": {
            "items": {
              "required": [
                "credible_interval",
                "weak_probability",
                "mastered_probability",
                "applicable_items",
                "status_reason",
                "performance"
              ]
            }
          },
          "issues": {
            "items": {
              "required": [
                "rubric_evidence"
              ]
            }
          }
        }
      }
    }
  ]
}
