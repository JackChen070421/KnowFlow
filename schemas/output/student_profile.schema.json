{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflow.local/schemas/output/student_profile.schema.json",
  "title": "student_profile.json",
  "description": "任务 2 个体画像（contract v0.5）：按测验节点统计知识点级诊断 + 课标聚合 + 问题 + 三张清单。mastery 为满分成功率的 Beta(1+k, 1+n-k) 后验均值；无观测为 null，不是 0。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "student_id",
    "group_id",
    "node_id",
    "generated_at",
    "source_dataset",
    "coverage",
    "knowledge_states",
    "objective_states",
    "issues",
    "lists"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "student_id": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "group_id": {
      "type": "string",
      "pattern": "^G[0-9]{1,2}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^N[0-9]{2}$",
      "description": "本画像所属测验节点；画像按节点产出，跨节点不合并（见 CONTRACT §5.3）"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_dataset": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_items",
        "applicable_items",
        "ratio",
        "scope_known",
        "observed_knowledge",
        "total_knowledge"
      ],
      "properties": {
        "observed_items": {"type": "integer", "minimum": 0},
        "applicable_items": {"type": "integer", "minimum": 0},
        "ratio": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "observed_items / applicable_items；无参与证据或分母为 0 时为 null，不写 0"
        },
        "scope_known": {
          "type": "boolean",
          "description": "该生在该节点是否留有参与证据；false 时 ratio 必须为 null"
        },
        "observed_knowledge": {"type": "integer", "minimum": 0},
        "total_knowledge": {"type": "integer", "minimum": 0}
      }
    },
    "knowledge_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "objective_id",
          "mastery",
          "confidence",
          "evidence_count",
          "status",
          "state_counts",
          "evidence",
          "credible_interval",
          "weak_probability",
          "mastered_probability",
          "applicable_items",
          "status_reason",
          "performance"
        ],
        "properties": {
          "knowledge_id": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
          "objective_id": {"type": "string", "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$"},
          "mastery": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "后验均值；无观测时为 null，不是 0"
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "evidence_count": {"type": "integer", "minimum": 0},
          "status": {
            "type": "string",
            "enum": [
              "confirmed_weak",
              "likely_weak",
              "insufficient_evidence",
              "unobserved",
              "sparse_good",
              "sparse_poor",
              "likely_mastered",
              "confirmed_mastered",
              "mixed_performance",
              "not_applicable"
            ],
            "description": "判读顺序见 CONTRACT §5.5；mixed_performance = 中间或混合表现；sparse_good = 门槛以下全对，或门槛以上未归入掌握/薄弱且对数不少于错数；sparse_poor = 门槛以下有错误，或门槛以上未归入掌握/薄弱且错数更多；insufficient_evidence = 待评分或复核后无可用评分；unobserved = 本节点有可测题但一条已评分作答都没有；not_applicable = 本节点无该知识点可测题目"
          },
          "evidence_action": {
            "type": ["string", "null"],
            "enum": [
              "probe",
              "not_attempted",
              "pending",
              "sparse_weak",
              "sparse_mastered",
              "sparse_mixed",
              null
            ],
            "description": "稀疏观测下的下一步动作，与 status 解耦：probe = 无任何记录，先布置基线题；not_attempted = 已布置未作答；pending = 已作答待评分；sparse_* = 后验已达梯度门槛。非稀疏状态为 null"
          },
          "state_counts": {
            "type": "object",
            "additionalProperties": false,
            "description": "五项之和 = 该知识点可测材料数；evidence_count = observed_correct + observed_wrong。",
            "required": [
              "observed_correct",
              "observed_wrong",
              "assigned_not_attempted",
              "pending",
              "unobserved"
            ],
            "properties": {
              "observed_correct": {"type": "integer", "minimum": 0},
              "observed_wrong": {"type": "integer", "minimum": 0},
              "assigned_not_attempted": {"type": "integer", "minimum": 0},
              "pending": {
                "type": "integer",
                "minimum": 0,
                "description": "已作答但未评分的材料项数；不计入 evidence_count，也不判为错误"
              },
              "unobserved": {"type": "integer", "minimum": 0}
            }
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string", "pattern": "^(R-[0-9]{4}|EV-[A-Za-z0-9._-]{6,40})$"},
            "uniqueItems": true
          },
          "credible_interval": {
            "type": ["array", "null"],
            "items": {"type": "number", "minimum": 0, "maximum": 1},
            "minItems": 2,
            "maxItems": 2,
            "description": "等尾可信区间 [low, high]；n=0 时为 null"
          },
          "weak_probability": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "P(p < 薄弱阈值 | 证据)；n=0 时为 null"
          },
          "mastered_probability": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "P(p > 掌握阈值 | 证据)；n=0 时为 null"
          },
          "applicable_items": {
            "type": "integer",
            "minimum": 0,
            "description": "该知识点在本节点的可测材料数，等于 state_counts 五项之和"
          },
          "status_reason": {
            "type": "string",
            "minLength": 1,
            "description": "一句话说明为何是这个 status；不得只重复枚举值"
          },
          "performance": {
            "type": "object",
            "additionalProperties": false,
            "description": "部分得分与零分的另报口径；不等于掌握度",
            "required": ["full_credit", "partial_credit", "zero_credit", "mean_score_ratio"],
            "properties": {
              "full_credit": {"type": "integer", "minimum": 0},
              "partial_credit": {"type": "integer", "minimum": 0},
              "zero_credit": {"type": "integer", "minimum": 0},
              "mean_score_ratio": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1,
                "description": "有效评分记录的 score/max_score 均值；n=0 时为 null"
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "description": "可选：仅当该知识点存在存疑评分时出现（contract v0.7）。evidence/state_counts/performance 永远是官方账本；usable_* 是去掉存疑记录后的可复算口径；policy=exclude_flagged 时顶层 mastery/status 取 usable_*，否则取官方值。",
            "required": [
              "policy",
              "disputed_record_ids",
              "flags",
              "usable_evidence",
              "usable_evidence_count",
              "usable_full_credit",
              "usable_mastery",
              "usable_status",
              "official_mastery",
              "official_status",
              "status_changed"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "enum": ["official", "exclude_flagged"],
                "description": "official=顶层数字按官方账本；exclude_flagged=顶层数字按剔除存疑证据后的口径"
              },
              "disputed_record_ids": {
                "type": "array",
                "items": {"type": "string", "pattern": "^(R-[0-9]{4}|EV-[A-Za-z0-9._-]{6,40})$"},
                "uniqueItems": true,
                "minItems": 1
              },
              "flags": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["record_id", "review_status", "flag_codes"],
                  "properties": {
                    "record_id": {"type": "string", "pattern": "^(R-[0-9]{4}|EV-[A-Za-z0-9._-]{6,40})$"},
                    "review_status": {
                      "type": "string",
                      "enum": ["flagged", "confirmed_issue", "dismissed", "needs_more_evidence"]
                    },
                    "flag_codes": {
                      "type": "array",
                      "items": {"type": "string", "minLength": 1},
                      "uniqueItems": true
                    }
                  }
                }
              },
              "usable_evidence": {
                "type": "array",
                "items": {"type": "string", "pattern": "^(R-[0-9]{4}|EV-[A-Za-z0-9._-]{6,40})$"},
                "uniqueItems": true
              },
              "usable_evidence_count": {"type": "integer", "minimum": 0},
              "usable_full_credit": {"type": "integer", "minimum": 0},
              "usable_mastery": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "usable_status": {
                "type": "string",
                "enum": [
                  "confirmed_weak",
                  "likely_weak",
                  "insufficient_evidence",
                  "unobserved",
                  "sparse_good",
                  "sparse_poor",
                  "likely_mastered",
                  "confirmed_mastered",
                  "mixed_performance",
                  "not_applicable"
                ]
              },
              "official_mastery": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "official_status": {
                "type": "string",
                "enum": [
                  "confirmed_weak",
                  "likely_weak",
                  "insufficient_evidence",
                  "unobserved",
                  "sparse_good",
                  "sparse_poor",
                  "likely_mastered",
                  "confirmed_mastered",
                  "mixed_performance",
                  "not_applicable"
                ]
              },
              "status_changed": {"type": "boolean"},
              "note": {"type": "string"}
            }
          }
        }
      }
    },
    "objective_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id",
          "mastery",
          "confidence",
          "evidence_count",
          "status",
          "derived_from",
          "unobserved_knowledge_ids"
        ],
        "properties": {
          "objective_id": {"type": "string", "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$"},
          "mastery": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "evidence_count": {"type": "integer", "minimum": 0},
          "status": {
            "type": "string",
            "enum": [
              "confirmed_weak",
              "likely_weak",
              "insufficient_evidence",
              "sparse_good",
              "sparse_poor",
              "likely_mastered",
              "confirmed_mastered",
              "mixed_performance",
              "unobserved",
              "not_applicable"
            ]
          },
          "derived_from": {
            "type": "array",
            "items": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
            "uniqueItems": true
          },
          "unobserved_knowledge_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
            "uniqueItems": true
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "type",
          "knowledge_id",
          "objective_id",
          "statement",
          "evidence",
          "severity",
          "rubric_evidence"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^IS-[0-9]{3}-[0-9]{2,3}$",
            "description": "IS-<学生三位>-<知识点序号>；第二段是 knowledge_id 的数字部分，同一学生同一知识点跨节点稳定。每学生每知识点至多一条 issue"
          },
          "type": {
            "type": "string",
            "enum": [
              "concept_confusion",
              "procedure_gap",
              "reading_error",
              "prerequisite_gap",
              "transfer_gap",
              "insufficient_evidence",
              "performance_gap",
              "score_point_gap"
            ]
          },
          "knowledge_id": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
          "objective_id": {"type": "string", "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$"},
          "statement": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["records", "material_ids", "stat"],
            "properties": {
              "records": {
                "type": "array",
                "items": {"type": "string", "pattern": "^(R-[0-9]{4}|EV-[A-Za-z0-9._-]{6,40})$"},
                "uniqueItems": true
              },
              "material_ids": {
                "type": "array",
                "items": {"type": "string", "pattern": "^M-[0-9]{3}$"},
                "uniqueItems": true
              },
              "stat": {"type": "string", "minLength": 1}
            }
          },
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "rubric_evidence": {
            "type": "array",
            "description": "评分点级失分证据；空数组表示已核查且无可引用评分点，不是未计算",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["record_id", "material_id", "point_id", "criterion", "score", "max_score"],
              "properties": {
                "record_id": {"type": "string", "pattern": "^(R-[0-9]{4}|EV-[A-Za-z0-9._-]{6,40})$"},
                "material_id": {"type": "string", "pattern": "^M-[0-9]{3}$"},
                "point_id": {"type": "string", "pattern": "^M-[0-9]{3}P[0-9]+$"},
                "criterion": {
                  "type": "string",
                  "minLength": 1,
                  "description": "官方评分点原文标签，不自动合并同义项"
                },
                "score": {"type": "number", "minimum": 0},
                "max_score": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          },
          "disputed_rubric_evidence": {
            "type": "array",
            "description": "可选：被排除出结论的存疑评分点（contract v0.7）。只作复核线索，不进入 rubric_evidence，也不进入建议依据。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "record_id",
                "material_id",
                "point_id",
                "criterion",
                "score",
                "max_score",
                "review_status"
              ],
              "properties": {
                "record_id": {"type": "string", "pattern": "^(R-[0-9]{4}|EV-[A-Za-z0-9._-]{6,40})$"},
                "material_id": {"type": "string", "pattern": "^M-[0-9]{3}$"},
                "point_id": {"type": "string", "pattern": "^M-[0-9]{3}P[0-9]+$"},
                "criterion": {"type": "string", "minLength": 1},
                "score": {"type": "number", "minimum": 0},
                "max_score": {"type": "number", "exclusiveMinimum": 0},
                "review_status": {
                  "type": "string",
                  "enum": ["flagged", "confirmed_issue", "dismissed", "needs_more_evidence"]
                },
                "flag_codes": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strengths", "needs_consolidation", "needs_observation", "needs_coverage"],
      "properties": {
        "strengths": {
          "type": "array",
          "items": {"$ref": "#/$defs/list_item"}
        },
        "needs_consolidation": {
          "type": "array",
          "items": {"$ref": "#/$defs/list_item"}
        },
        "needs_observation": {
          "type": "array",
          "items": {"$ref": "#/$defs/list_item"},
          "description": "有 1~2 条有效评分、还看不清方向的知识点；需要的是“再测一次”"
        },
        "needs_coverage": {
          "type": "array",
          "items": {"$ref": "#/$defs/list_item"},
          "description": "本节点有可测题但一条已评分作答都没有的知识点；需要的是“先布置基线题”，未覆盖不等于未掌握"
        }
      }
    }
  },
  "$defs": {
    "list_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_id", "reason"],
      "properties": {
        "knowledge_id": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
