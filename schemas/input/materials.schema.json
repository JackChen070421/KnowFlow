{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflow.local/schemas/input/materials.schema.json",
  "title": "materials.csv row",
  "description": "一行 = 一份材料/题目/课标参考文档。官方未标注主题或难度时 objective_id/difficulty 为 null（不猜）。canonical v0.3。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "material_id",
    "title",
    "body",
    "material_type",
    "difficulty",
    "objective_id"
  ],
  "properties": {
    "material_id": {
      "type": "string",
      "pattern": "^M-[0-9]{3}$",
      "description": "材料主键，如 M-021"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "标题"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "题干/正文"
    },
    "material_type": {
      "type": "string",
      "enum": ["reference", "explain", "example", "practice", "assessment", "probe"],
      "description": "材料类型：参考/讲解/例题/练习/测评/探测"
    },
    "item_format": {
      "type": ["string", "null"],
      "enum": ["choice", "blank", "solution", null],
      "description": "题型：选择/填空/解答；非题目材料为 null"
    },
    "difficulty": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5,
      "description": "难度 1–5；官方数据未提供时为 null，下游不得当作 1 或默认值"
    },
    "objective_id": {
      "type": ["string", "null"],
      "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$",
      "description": "主要对应课标条目；教材等无主题材料为 null（不猜）"
    },
    "options_json": {
      "type": ["string", "null"],
      "description": "JSON 数组字符串，如 [\"A\",\"B\",\"C\",\"D\"]"
    },
    "answer_key": {
      "type": ["string", "null"],
      "description": "标准答案/评分要点"
    },
    "explanation": {
      "type": ["string", "null"],
      "description": "参考解析原文；非题目材料为 null"
    },
    "rubric_json": {
      "type": ["string", "null"],
      "description": "评分点 JSON 数组字符串，元素 {id,text,points}，id 用 canonical 材料 ID，如 [{\"id\":\"M-043P1\",\"text\":\"答案正确\",\"points\":1}]"
    },
    "attachments_json": {
      "type": ["string", "null"],
      "description": "JSON 数组字符串（文件名/URL）"
    },
    "est_minutes": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 600,
      "description": "预计用时（分钟）"
    },
    "source": {
      "type": ["string", "null"],
      "description": "来源"
    },
    "license": {
      "type": ["string", "null"],
      "description": "许可证/授权说明"
    }
  },
  "x-primary-key": ["material_id"],
  "x-file": "materials.csv"
}
