{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflow.local/schemas/input/materials.schema.json",
  "title": "materials.csv row",
  "description": "一行 = 一份材料/题目/课标参考文档。canonical v0.1。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "material_id",
    "title",
    "body",
    "material_type",
    "difficulty",
    "objective_id"
  ],
  "properties": {
    "material_id": {
      "type": "string",
      "pattern": "^M-[0-9]{3}$",
      "description": "材料主键，如 M-021"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "标题"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "题干/正文"
    },
    "material_type": {
      "type": "string",
      "enum": ["reference", "explain", "example", "practice", "assessment", "probe"],
      "description": "材料类型：参考/讲解/例题/练习/测评/探测"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "难度 1–5"
    },
    "objective_id": {
      "type": "string",
      "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$",
      "description": "主要对应课标条目"
    },
    "options_json": {
      "type": ["string", "null"],
      "description": "JSON 数组字符串，如 [\"A\",\"B\",\"C\",\"D\"]"
    },
    "answer_key": {
      "type": ["string", "null"],
      "description": "标准答案/评分要点"
    },
    "attachments_json": {
      "type": ["string", "null"],
      "description": "JSON 数组字符串（文件名/URL）"
    },
    "est_minutes": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 600,
      "description": "预计用时（分钟）"
    },
    "source": {
      "type": ["string", "null"],
      "description": "来源"
    },
    "license": {
      "type": ["string", "null"],
      "description": "许可证/授权说明"
    }
  },
  "x-primary-key": ["material_id"],
  "x-file": "materials.csv"
}
