{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflow.local/schemas/input/qmatrix.schema.json",
  "title": "qmatrix.csv row",
  "description": "一行 = 一个材料×知识点测量关系。主键 (material_id, knowledge_id)。canonical v0.1。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "material_id",
    "knowledge_id",
    "weight",
    "difficulty",
    "item_type"
  ],
  "properties": {
    "material_id": {
      "type": "string",
      "pattern": "^M-[0-9]{3}$",
      "description": "材料 ID"
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^K-[0-9]{2,3}$",
      "description": "知识点 ID"
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "该材料对该知识点的测量权重"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "题目难度 1–5"
    },
    "item_type": {
      "type": "string",
      "enum": ["explain", "example", "practice", "assessment", "probe"],
      "description": "题型/用途"
    },
    "is_primary": {
      "type": ["boolean", "null"],
      "description": "是否主测量点"
    }
  },
  "x-primary-key": ["material_id", "knowledge_id"],
  "x-file": "qmatrix.csv"
}
