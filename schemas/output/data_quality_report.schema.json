{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflow.local/schemas/output/data_quality_report.schema.json",
  "title": "data_quality_report.json",
  "description": "任务 2 数据处理证据（contract v0.5）：输入哈希、逐行清洗决策、五态记账、缺失、异常、处理规则。input_records / rejected_records / partial_credit_records / decisions 为 v0.5 可选扩展；诊断运行必须提供，并满足 input_records = total_records + duplicates_removed + rejected_records。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "generated_at",
    "input_files",
    "total_records",
    "duplicates_removed",
    "records_by_state",
    "missing",
    "anomalies",
    "field_quality",
    "handling_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "rows"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "rows": {"type": "integer", "minimum": 0}
        }
      }
    },
    "total_records": {
      "type": "integer",
      "minimum": 0
    },
    "duplicates_removed": {
      "type": "integer",
      "minimum": 0
    },
    "input_records": {
      "type": "integer",
      "minimum": 0,
      "description": "官方作答记录原始行数；input_records = total_records + duplicates_removed + rejected_records"
    },
    "rejected_records": {
      "type": "integer",
      "minimum": 0,
      "description": "被隔离（不进入分析层）的记录数；每条隔离都要在 decisions 里有对应行"
    },
    "partial_credit_records": {
      "type": "integer",
      "minimum": 0,
      "description": "0 < score < max_score 的记录数；属于未满分证据，不等同于答错"
    },
    "records_by_state": {
      "type": "object",
      "additionalProperties": false,
      "description": "按记录行计数：observed_correct + observed_wrong + pending + assigned_not_attempted = total_records；unobserved 在此恒为 0（无记录不落行），缺测见 missing 与 coverage。",
      "required": [
        "observed_correct",
        "observed_wrong",
        "assigned_not_attempted",
        "pending",
        "unobserved"
      ],
      "properties": {
        "observed_correct": {"type": "integer", "minimum": 0},
        "observed_wrong": {"type": "integer", "minimum": 0},
        "assigned_not_attempted": {"type": "integer", "minimum": 0},
        "pending": {
          "type": "integer",
          "minimum": 0,
          "description": "已作答、未评分；不进 evidence，也不算错"
        },
        "unobserved": {"type": "integer", "minimum": 0}
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "students_without_records",
        "items_without_records",
        "empty_answers"
      ],
      "properties": {
        "students_without_records": {"type": "integer", "minimum": 0},
        "items_without_records": {"type": "integer", "minimum": 0},
        "empty_answers": {"type": "integer", "minimum": 0}
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "reason", "action"],
        "properties": {
          "record_id": {"type": ["string", "null"], "pattern": "^R-[0-9]{4}$"},
          "reason": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1}
        }
      }
    },
    "field_quality": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "issue", "count"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "issue": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "handling_rules": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "decisions": {
      "type": "array",
      "description": "逐行清洗审计：官方 CSV 每一行恰好一条决策，不允许静默丢弃。retained 可无附加原因；superseded / rejected 必须写原因。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_row", "record_id", "decision", "reasons"],
        "properties": {
          "source_row": {
            "type": "integer",
            "minimum": 2,
            "description": "官方 CSV 逻辑行号（含表头，1 起），不是物理文本行"
          },
          "record_id": {
            "type": ["string", "null"],
            "pattern": "^R-[0-9]{4}$"
          },
          "decision": {
            "type": "string",
            "enum": ["retained", "superseded", "rejected"]
          },
          "reasons": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"decision": {"enum": ["superseded", "rejected"]}},
              "required": ["decision"]
            },
            "then": {
              "properties": {"reasons": {"minItems": 1}}
            }
          }
        ]
      }
    }
  }
}
