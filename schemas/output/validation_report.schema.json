{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflow.local/schemas/output/validation_report.schema.json",
  "title": "validation_report.json",
  "description": "G1–G5 校验报告：schema、引用、一致性、约束、隐私。gate=pass 才能进交付物。canonical v0.5；任务3可选 errors/policy_version。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "targets",
    "checks",
    "summary",
    "gate"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "schema_id"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "schema_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "passed", "message", "refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "level": {"type": "string", "enum": ["error", "warning", "info"]},
          "passed": {"type": "boolean"},
          "message": {"type": "string", "minLength": 1},
          "refs": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "warnings"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      }
    },
    "gate": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"},
      "description": "可选：失败明细；前 50 条，完整复核仍看 checks/targets"
    },
    "policy_version": {
      "type": "string",
      "description": "可选：任务3规则版本，便于复核建议口径"
    }
  }
}
