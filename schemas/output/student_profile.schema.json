{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflow.local/schemas/output/student_profile.schema.json",
  "title": "student_profile.json",
  "description": "任务 2 个体画像：知识点级诊断 + 课标聚合 + 问题 + 三张清单。canonical v0.1。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "student_id",
    "group_id",
    "generated_at",
    "source_dataset",
    "coverage",
    "knowledge_states",
    "objective_states",
    "issues",
    "lists"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "student_id": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "group_id": {
      "type": "string",
      "pattern": "^G[0-9]{1,2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_dataset": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_items",
        "applicable_items",
        "ratio",
        "observed_knowledge",
        "total_knowledge"
      ],
      "properties": {
        "observed_items": {"type": "integer", "minimum": 0},
        "applicable_items": {"type": "integer", "minimum": 0},
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "observed_knowledge": {"type": "integer", "minimum": 0},
        "total_knowledge": {"type": "integer", "minimum": 0}
      }
    },
    "knowledge_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "objective_id",
          "mastery",
          "confidence",
          "evidence_count",
          "status",
          "state_counts",
          "evidence"
        ],
        "properties": {
          "knowledge_id": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
          "objective_id": {"type": "string", "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$"},
          "mastery": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "后验均值；无观测时为 null，不是 0"
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "evidence_count": {"type": "integer", "minimum": 0},
          "status": {
            "type": "string",
            "enum": [
              "confirmed_weak",
              "likely_weak",
              "insufficient_evidence",
              "likely_mastered",
              "confirmed_mastered"
            ]
          },
          "state_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_correct",
              "observed_wrong",
              "assigned_not_attempted",
              "unobserved"
            ],
            "properties": {
              "observed_correct": {"type": "integer", "minimum": 0},
              "observed_wrong": {"type": "integer", "minimum": 0},
              "assigned_not_attempted": {"type": "integer", "minimum": 0},
              "unobserved": {"type": "integer", "minimum": 0}
            }
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string", "pattern": "^R-[0-9]{4}$"},
            "uniqueItems": true
          }
        }
      }
    },
    "objective_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id",
          "mastery",
          "confidence",
          "evidence_count",
          "status",
          "derived_from",
          "unobserved_knowledge_ids"
        ],
        "properties": {
          "objective_id": {"type": "string", "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$"},
          "mastery": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "evidence_count": {"type": "integer", "minimum": 0},
          "status": {
            "type": "string",
            "enum": [
              "confirmed_weak",
              "likely_weak",
              "insufficient_evidence",
              "likely_mastered",
              "confirmed_mastered"
            ]
          },
          "derived_from": {
            "type": "array",
            "items": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
            "uniqueItems": true
          },
          "unobserved_knowledge_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
            "uniqueItems": true
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "type",
          "knowledge_id",
          "objective_id",
          "statement",
          "evidence",
          "severity"
        ],
        "properties": {
          "issue_id": {"type": "string", "pattern": "^IS-[0-9]{3}-[0-9]{2}$"},
          "type": {
            "type": "string",
            "enum": [
              "concept_confusion",
              "procedure_gap",
              "reading_error",
              "prerequisite_gap",
              "transfer_gap",
              "insufficient_evidence"
            ]
          },
          "knowledge_id": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
          "objective_id": {"type": "string", "pattern": "^OBJ-[0-9][A-Z]{1,2}-[0-9]{2,3}$"},
          "statement": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["records", "material_ids", "stat"],
            "properties": {
              "records": {
                "type": "array",
                "items": {"type": "string", "pattern": "^R-[0-9]{4}$"},
                "uniqueItems": true
              },
              "material_ids": {
                "type": "array",
                "items": {"type": "string", "pattern": "^M-[0-9]{3}$"},
                "uniqueItems": true
              },
              "stat": {"type": "string", "minLength": 1}
            }
          },
          "severity": {"type": "string", "enum": ["low", "medium", "high"]}
        }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strengths", "needs_consolidation", "needs_observation"],
      "properties": {
        "strengths": {
          "type": "array",
          "items": {"$ref": "#/$defs/list_item"}
        },
        "needs_consolidation": {
          "type": "array",
          "items": {"$ref": "#/$defs/list_item"}
        },
        "needs_observation": {
          "type": "array",
          "items": {"$ref": "#/$defs/list_item"}
        }
      }
    }
  },
  "$defs": {
    "list_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_id", "reason"],
      "properties": {
        "knowledge_id": {"type": "string", "pattern": "^K-[0-9]{2,3}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
