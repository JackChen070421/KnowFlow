# KnowFlow environment variables
# 复制为 .env 后填写；.env 永不提交。
# 只放变量名/示例，不放真实密钥。

# --- LLM provider (summary-only boundary) ---
# 只用聚合摘要调用；原始学情数据不得发送。
KNOWFLOW_LLM_ENABLED=false
KNOWFLOW_LLM_PROVIDER=deepseek
KNOWFLOW_LLM_BASE_URL=https://api.deepseek.com
KNOWFLOW_LLM_MODEL=deepseek-chat
KNOWFLOW_LLM_API_KEY=
KNOWFLOW_LLM_TEMPERATURE=0.2
KNOWFLOW_LLM_TIMEOUT_SECONDS=30

# --- paths ---
KNOWFLOW_DATA_DIR=./data
KNOWFLOW_ARTIFACT_DIR=./artifacts

# --- runtime ---
KNOWFLOW_LOG_LEVEL=INFO
KNOWFLOW_RANDOM_SEED=20261108
